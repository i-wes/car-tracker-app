rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reguła ogólna dla kolekcji 'users'
    match /users/{userId} {
      // Użytkownik może czytać i pisać TYLKO do dokumentów wewnątrz SWOJEGO folderu (uid)
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Reguły kaskadowe w dół dla podkolekcji (wydatki, przypomnienia)
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
